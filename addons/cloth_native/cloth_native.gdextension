[configuration]

entry_symbol = "cloth_native_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]

macos.debug = "res://addons/cloth_native/bin/libcloth_native.macos.template_debug.framework"
macos.release = "res://addons/cloth_native/bin/libcloth_native.macos.template_release.framework"
windows.debug.x86_64 = "res://addons/cloth_native/bin/libcloth_native.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/cloth_native/bin/libcloth_native.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/cloth_native/bin/libcloth_native.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/cloth_native/bin/libcloth_native.linux.template_release.x86_64.so"
